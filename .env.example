# Copy to .env for local overrides. Docker Compose sets these itself.
# Do not put production secrets in this file. The sample password is for local Postgres only.
# The installed Mac app does not read this file. It uses SQLite under
# ~/Library/Application Support/SheetFlow unless SHEETFLOW_DATA_DIR is set.

DATABASE_URL=postgresql+psycopg://symphony:symphony@127.0.0.1:5432/symphony
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=20971520
MAX_ROWS_PER_SHEET=50000
MAX_COLUMNS=200
MAX_SHEETS=30
PREVIEW_ROWS=50
WORKER_POLL_SECONDS=0.5
STALE_JOB_SECONDS=1800
DEFAULT_LOCALE=en-US
TRANSFORM_VERSION=1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
WORKER_ENABLED=true
